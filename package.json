{
  "name": "pi-kimi-style-todo",
  "version": "0.1.0",
  "description": "Kimi-inspired compact TODO widget for Pi, with branch-local task state and session replay.",
  "type": "module",
  "license": "MIT",
  "author": "M1racleShih",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "repository": { "type": "git", "url": "git+https://github.com/M1racleShih/pi-kimi-style-todo.git" },
  "keywords": ["pi-package", "pi-extension", "todo", "kimi-style"],
  "engines": { "node": ">=22.19.0" },
  "pi": { "extensions": ["./index.ts"] },
  "files": [
    "index.ts", "config.ts", "todo.ts", "todo-overlay.ts", "locales/",
    "state/invariants.ts", "state/i18n-bridge.ts", "state/replay.ts", "state/selectors.ts",
    "state/state-reducer.ts", "state/state.ts", "state/store.ts", "state/task-graph.ts",
    "tool/normalize-params.ts", "tool/response-envelope.ts", "tool/sanitize.ts", "tool/types.ts", "view/format.ts", "view/layout.ts", "view/todo-list.ts",
    "LICENSE", "licenses/", "THIRD_PARTY_NOTICES.md", "UPSTREAM.json", "README.md", "docs/", "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node scripts/isolated.mjs unit",
    "check": "tsc --noEmit",
    "test:load": "node scripts/isolated.mjs load",
    "test:tui": "node scripts/isolated.mjs tui",
    "test:pack": "node scripts/isolated.mjs pack",
    "verify": "npm run check && npm test && npm run test:load && npm run test:pack"
  },
  "dependencies": { "@juicesharp/rpiv-config": "2.13.8" },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "@juicesharp/rpiv-i18n": "*"
  },
  "peerDependenciesMeta": { "@juicesharp/rpiv-i18n": { "optional": true } },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@juicesharp/rpiv-i18n": "2.13.8",
    "@types/node": "24.10.1",
    "@xterm/headless": "5.5.0",
    "tsx": "4.20.6",
    "typebox": "1.3.27",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@earendil-works/pi-ai": "$@earendil-works/pi-ai",
    "@earendil-works/pi-agent-core": "$@earendil-works/pi-agent-core",
    "@earendil-works/pi-coding-agent": "$@earendil-works/pi-coding-agent",
    "@earendil-works/pi-tui": "$@earendil-works/pi-tui"
  }
}
